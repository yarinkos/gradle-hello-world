.gradle
**/build/
!src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# IDEs
.idea/
*.iml
*.ipr
*.iws
out/
.vscode/
.settings/
bin/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Secrets and local environment: never commit credentials
.env
.env.*
*.pem
*.key
*.p12
*token*.txt
*secret*
